# Bỏ qua tất cả các thư mục node_modules ở bất kỳ đâu trong dự án
node_modules/

# Bỏ qua file chứa mật khẩu/key bảo mật của cả BE và FE
.env

# Bỏ qua các file log hệ thống
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Bỏ qua thư mục build của React (khi deploy mới cần)
dist/
build/

# Bỏ qua file rác của hệ điều hành
.DS_Store
Thumbs.db